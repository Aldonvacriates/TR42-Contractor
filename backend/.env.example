# backend/.env.example
# Copy this file to .env and set your own values.
# DO NOT commit .env — it should be in .gitignore.

# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# ── AI provider ───────────────────────────────────────────────
# Active provider for /api/ai/* routes. Default: gemini.
# resilient_call automatically falls back to the OTHER configured provider
# on transient errors, so setting multiple keys gives the demo extra safety.
#   AI_PROVIDER=gemini | anthropic | ollama
AI_PROVIDER=gemini

# Gemini (Google AI Studio). Free tier with rate limits; sometimes 503s
# at peak hours. Get your key at:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude. Optional fallback; needs paid credits.
#   https://console.anthropic.com
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5

# Ollama Cloud. Hosts open models (gpt-oss, qwen3-vl, deepseek, etc.) via
# an OpenAI-compatible API. Has a generous free tier.
#   https://ollama.com (sign up, then create a key from your account page)
# Cloud-hosted models need the ":cloud" suffix; local Ollama uses the same
# names without the suffix.
# OLLAMA_API_KEY=your-ollama-api-key-here
# OLLAMA_MODEL=gpt-oss:120b-cloud
# OLLAMA_VISION_MODEL=qwen3-vl:235b-cloud
# OLLAMA_BASE_URL=https://ollama.com/v1

# ── Database ─────────────────────────────────────────────────
# Local dev: leave commented out so Flask falls back to local SQLite.
# Per backend/DATABASE_SAFETY.md, never point the local backend at the
# shared Supabase Postgres. Daniel's data is precious.
# DATABASE_URL=postgresql://...
