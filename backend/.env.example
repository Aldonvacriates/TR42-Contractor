# backend/.env.example
# Copy this file to .env and set your own values.
# DO NOT commit .env — it should be in .gitignore.

# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# ── AI provider ───────────────────────────────────────────────
# Active provider for /api/ai/* routes. Default: gemini.
# Switch to anthropic if Gemini misbehaves; the wire format is identical.
#   AI_PROVIDER=gemini | anthropic
AI_PROVIDER=gemini

# Primary provider (Gemini 2.5 Flash). Get your key at:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default model
# GEMINI_MODEL=gemini-2.5-flash

# Fallback provider (Anthropic Claude). Optional, only needed if you set
# AI_PROVIDER=anthropic or want a hot fallback.
# Get your key at https://console.anthropic.com
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5

# ── Database ─────────────────────────────────────────────────
# Local dev: leave commented out so Flask falls back to local SQLite.
# Per backend/DATABASE_SAFETY.md, never point the local backend at the
# shared Supabase Postgres. Daniel's data is precious.
# DATABASE_URL=postgresql://...
